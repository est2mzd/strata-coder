{
  "name": "strata-coder",
  "displayName": "Strata-Coder",
  "description": "Let Cursor supervise local coding workers powered by Strata over SSH.",
  "version": "0.3.0",
  "publisher": "est2mzd",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/est2mzd/strata-coder.git"
  },
  "engines": {
    "vscode": "^1.96.0"
  },
  "categories": [
    "AI",
    "Other"
  ],
  "main": "./extension/extension.js",
  "extensionKind": [
    "workspace"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "test": "python3 -m unittest discover -s tests -v",
    "check": "node --check extension/extension.js"
  },
  "contributes": {
    "commands": [
      {
        "command": "strataCoder.connect",
        "title": "Strata-Coder: Register / Reconnect"
      },
      {
        "command": "strataCoder.checkConnection",
        "title": "Strata-Coder: Check Connection"
      },
      {
        "command": "strataCoder.setApiKey",
        "title": "Strata-Coder: Set API Key"
      },
      {
        "command": "strataCoder.setCoordinatorToken",
        "title": "Strata-Coder: Set Coordinator Token"
      },
      {
        "command": "strataCoder.showTasks",
        "title": "Strata-Coder: Show Task Status"
      },
      {
        "command": "strataCoder.prepareDecision",
        "title": "Strata-Coder: Prepare Decision Batch"
      },
      {
        "command": "strataCoder.copyDecision",
        "title": "Strata-Coder: Copy Decision Brief"
      },
      {
        "command": "strataCoder.executeDecision",
        "title": "Strata-Coder: Execute Decision"
      }
    ],
    "configuration": {
      "title": "Strata-Coder",
      "properties": {
        "strataCoder.connectionMode": {
          "type": "string",
          "enum": [
            "ssh",
            "direct"
          ],
          "default": "ssh",
          "scope": "machine",
          "description": "SSH owns a loopback tunnel. Direct connects to an existing tunnel or HTTPS API."
        },
        "strataCoder.sshHost": {
          "type": "string",
          "default": "gdx-spark",
          "scope": "machine",
          "description": "SSH config alias on the workspace host; key/agent authentication required."
        },
        "strataCoder.remotePort": {
          "type": "number",
          "default": 8080,
          "minimum": 1,
          "maximum": 65535,
          "scope": "machine"
        },
        "strataCoder.baseUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18080/v1",
          "scope": "machine"
        },
        "strataCoder.model": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Empty auto-selects the single loaded model."
        },
        "strataCoder.pythonPath": {
          "type": "string",
          "default": "python3",
          "scope": "machine",
          "description": "Python 3.10+ executable on the workspace host. Windows may need python."
        },
        "strataCoder.maxOutputTokens": {
          "type": "number",
          "default": 2048,
          "minimum": 128,
          "maximum": 8192,
          "scope": "machine"
        },
        "strataCoder.testCommands": {
          "type": "object",
          "default": {},
          "scope": "machine",
          "description": "Trusted test ID -> argv array. Runs repository code with your privileges; only trusted repos.",
          "additionalProperties": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        },
        "strataCoder.executionMode": {
          "type": "string",
          "enum": [
            "single",
            "queued"
          ],
          "default": "single",
          "description": "queued enables the shared coordinator; single retains v0.1 behavior.",
          "scope": "machine"
        },
        "strataCoder.workerConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 2,
          "description": "Concurrent local worktrees; independent of Cursor agent count.",
          "scope": "machine"
        },
        "strataCoder.testConcurrency": {
          "type": "integer",
          "minimum": 1,
          "maximum": 64,
          "default": 1,
          "description": "Concurrent configured tests on this workspace host.",
          "scope": "machine"
        },
        "strataCoder.coordinatorPort": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "default": 8091,
          "description": "Coordinator loopback port on SSH host (queued mode).",
          "scope": "machine"
        },
        "strataCoder.coordinatorUrl": {
          "type": "string",
          "default": "http://127.0.0.1:18091/v1",
          "description": "Existing SSH tunnel URL for coordinator in direct mode.",
          "scope": "machine"
        },
        "strataCoder.depth": {
          "type": "string",
          "enum": [
            "auto",
            "low",
            "medium",
            "high"
          ],
          "default": "auto",
          "scope": "machine",
          "description": "Default reasoning depth. Auto requires Cursor to select the effort and explain why when delegating. Explicit per-task user instructions override this default."
        },
        "strataCoder.supervisionMode": {
          "type": "string",
          "enum": [
            "decision",
            "legacy"
          ],
          "default": "decision",
          "scope": "machine",
          "description": "Decision mode exchanges brief decisions only; legacy registers the v0.2 worker MCP tools."
        }
      }
    }
  }
}
